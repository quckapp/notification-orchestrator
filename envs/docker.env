# =============================================================================
# NOTIFICATION ORCHESTRATOR - Docker Environment
# =============================================================================

# Application
MIX_ENV=prod
PORT=4004
PHX_HOST=localhost
PHX_SERVER=true

# Security
SECRET_KEY_BASE=dev_secret_key_base_min_64_chars_long_for_phoenix_app_1234567890abcdef
JWT_SECRET=dev_jwt_secret_change_in_production

# MongoDB
MONGODB_URL=mongodb://admin:admin_secret@mongodb:27017/notification_db?authSource=admin

# Redis
REDIS_URL=redis://:redis_secret@redis:6379

# Kafka
KAFKA_BROKERS=kafka:9092

# Auth Service
AUTH_SERVICE_URL=http://auth-service:8081

# Firebase Cloud Messaging (FCM)
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# Apple Push Notification Service (APNS)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_ENV=sandbox

# Email (SMTP)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@localhost
SMTP_FROM_NAME=QuckApp

# Erlang Distribution
RELEASE_COOKIE=quckapp_dev_cookie
NODE_NAME=notification@notification-orchestrator

# Observability
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
LOG_LEVEL=info

# Feature Flags
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_EMAIL=true
ENABLE_PUSH=false
