# =============================================================================
# NOTIFICATION ORCHESTRATOR - Test Environment
# =============================================================================

# Application
MIX_ENV=test
PORT=4104
PHX_HOST=localhost
PHX_SERVER=false

# Security
SECRET_KEY_BASE=test_secret_key_base_min_64_chars_long_for_phoenix_app_1234567890abcdef
JWT_SECRET=test_jwt_secret

# MongoDB
MONGODB_URL=mongodb://admin:admin_secret@localhost:27017/notification_db_test?authSource=admin

# Redis
REDIS_URL=redis://:redis_secret@localhost:6379/1

# Kafka
KAFKA_BROKERS=localhost:9092

# Auth Service
AUTH_SERVICE_URL=http://localhost:8081

# Firebase Cloud Messaging (FCM) - Disabled for tests
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# Apple Push Notification Service (APNS) - Disabled for tests
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_ENV=sandbox

# Email (SMTP) - Disabled for tests
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=test@localhost
SMTP_FROM_NAME=QuckApp Test

# Erlang Distribution
RELEASE_COOKIE=quckapp_test_cookie
NODE_NAME=notification_test@localhost

# Observability
JAEGER_ENDPOINT=
LOG_LEVEL=warn

# Feature Flags
ENABLE_METRICS=false
ENABLE_TRACING=false
ENABLE_EMAIL=false
ENABLE_PUSH=false
