# =============================================================================
# NOTIFICATION ORCHESTRATOR - Production Environment
# =============================================================================

# Application
MIX_ENV=prod
PORT=4004
PHX_HOST=quckapp.com
PHX_SERVER=true

# Security
SECRET_KEY_BASE=${SECRET_KEY_BASE}
JWT_SECRET=${JWT_SECRET}

# MongoDB
MONGODB_URL=${MONGODB_URL}

# Redis
REDIS_URL=${REDIS_URL}

# Kafka
KAFKA_BROKERS=${KAFKA_BROKERS}

# Auth Service
AUTH_SERVICE_URL=http://auth-service:8081

# Firebase Cloud Messaging (FCM)
FCM_PROJECT_ID=${FCM_PROJECT_ID}
FCM_PRIVATE_KEY=${FCM_PRIVATE_KEY}
FCM_CLIENT_EMAIL=${FCM_CLIENT_EMAIL}

# Apple Push Notification Service (APNS)
APNS_KEY_ID=${APNS_KEY_ID}
APNS_TEAM_ID=${APNS_TEAM_ID}
APNS_KEY_PATH=${APNS_KEY_PATH}
APNS_ENV=production

# Email (SMTP)
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=587
SMTP_USERNAME=${SMTP_USERNAME}
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_FROM_EMAIL=noreply@quckapp.com
SMTP_FROM_NAME=QuckApp

# Erlang Distribution
RELEASE_COOKIE=${ERLANG_COOKIE}
NODE_NAME=notification@${HOSTNAME}

# Observability
JAEGER_ENDPOINT=${JAEGER_ENDPOINT}
LOG_LEVEL=info

# Feature Flags
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_EMAIL=true
ENABLE_PUSH=true

# Performance
POOL_SIZE=20
NOTIFICATION_BATCH_SIZE=100
