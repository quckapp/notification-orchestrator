# =============================================================================
# NOTIFICATION ORCHESTRATOR - Environment Configuration Example
# =============================================================================
# Copy this file to .env and update with your values

# Application
MIX_ENV=dev
PORT=4004
PHX_HOST=localhost
PHX_SERVER=true

# Security
SECRET_KEY_BASE=your_secret_key_base_min_64_chars
JWT_SECRET=your_jwt_secret

# MongoDB
MONGODB_URL=mongodb://user:password@localhost:27017/notification_db?authSource=admin

# Redis
REDIS_URL=redis://:password@localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Auth Service
AUTH_SERVICE_URL=http://localhost:8081

# Firebase Cloud Messaging (FCM)
FCM_PROJECT_ID=your_fcm_project_id
FCM_PRIVATE_KEY=your_fcm_private_key
FCM_CLIENT_EMAIL=your_fcm_client_email

# Apple Push Notification Service (APNS)
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apns_team_id
APNS_KEY_PATH=/path/to/apns/key.p8

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@example.com

# Erlang Distribution
RELEASE_COOKIE=your_erlang_cookie

# Observability
JAEGER_ENDPOINT=http://localhost:14268/api/v1/traces
LOG_LEVEL=debug
